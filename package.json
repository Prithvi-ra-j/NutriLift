{
  "name": "nutrilift",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:supabase": "supabase test db --local supabase/tests/sync_records.test.sql",
    "audit": "npm audit --omit=dev --audit-level=high || echo 'Non-blocking dependency audit found vulnerabilities; inspect the log.'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:size": "node --experimental-strip-types tools/check-size.ts",
    "check:contrast": "node --experimental-strip-types tools/contrast.ts",
    "check:readme": "node --experimental-strip-types tools/check-readme.ts",
    "verify": "npm run typecheck && npm run lint && npm test -- --ci && npm run check:readme && npm run check:contrast"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.1.1",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-query": "^5.104.5",
    "aes-js": "^3.1.2",
    "babel-preset-expo": "~58.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "fast-base64-decode": "^1.0.0",
    "immer": "^11.1.8",
    "nativewind": "^4.2.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-uuid": "^2.0.4",
    "react-native-worklets": "0.13.0",
    "zod": "3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.1.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/apex/",
      "<rootDir>/supabase/functions/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@testing-library/react-native)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
