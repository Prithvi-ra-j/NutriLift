{
  "expo": {
    "name": "NutriLift",
    "slug": "apex",
    "owner": "prithviraj_12",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4d082b22-8f1b-4d8d-abd2-dfe2c41a172b",
      "checkAutomatically": "ON_LOAD"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prithvi.nutrilift"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.prithvi.nutrilift",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "scheme": "nutrilift",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-sharing",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow NutriLift to access your microphone for voice food logging."
        }
      ],
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "NutriLift scans barcodes to look up foods."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d082b22-8f1b-4d8d-abd2-dfe2c41a172b"
      }
    }
  }
}
